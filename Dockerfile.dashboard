FROM node:20-alpine
RUN apk add --no-cache docker-cli
WORKDIR /app

# Instala dependencias primero (capa cacheada)
COPY package.json .
RUN npm install --omit=dev

# Copia el codigo
COPY dashboard_backend/ ./dashboard_backend/
COPY dashboard/ ./dashboard/

EXPOSE 3003
CMD ["node", "dashboard_backend/index.js"]
